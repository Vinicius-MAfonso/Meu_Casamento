[Unit]
Description=Meu Casamento Gunicorn service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/meu-casamento
EnvironmentFile=/etc/meu-casamento/.env.prod
ExecStart=/srv/meu-casamento/.venv/bin/gunicorn meu_casamento.wsgi:application --bind 127.0.0.1:8000 --workers 3
Restart=always
RestartSec=5

# Keep secrets out of the repo: create /etc/meu-casamento/.env.prod with chmod 600
# and define at least DJANGO_ENV, SECRET_KEY, DEBUG, ALLOWED_HOSTS, CACHE_BACKEND
# and DATABASE_URL there.

[Install]
WantedBy=multi-user.target
