# Reference for the environment variables the app needs in production.
# Use this file on the server (for example in an EC2 deployment) or inject the
# same values through your orchestrator / systemd environment.

DJANGO_ENV=production

# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=False

# Your public hostnames or IPs, separated by commas.
# Example: ALLOWED_HOSTS=meucasamento.example.com,api.meucasamento.example.com
ALLOWED_HOSTS=meucasamento.example.com

# Optional cache backend for multi-worker deployments.
# Use 'database' for a shared cache across workers without extra services.
CACHE_BACKEND=database

# Database URL. PostgreSQL is recommended for production.
DATABASE_URL=postgres://user:password@host/dbname

